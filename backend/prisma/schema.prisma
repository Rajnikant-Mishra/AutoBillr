generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// COMPANY
// =====================================================

model Company {
  id          String   @id @default(cuid())
  name        String
  companySize String?
  industry    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients              Client[]
  invoices             Invoice[]
  subscriptions        Subscription[]
  subscriptionPayments SubscriptionPayment[]
  users                User[]
  projects             Project[]
  notifications        Notification[]
teamMembers  TeamMember[]
  roles       Role[]
  @@index([name])
}

// =====================================================
// USER
// =====================================================

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  avatar       String?
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// =====================================================
// PLAN
// =====================================================

model Plan {
  id          String   @id
  name        String
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  interval    String   @default("month")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions        Subscription[]
  subscriptionPayments SubscriptionPayment[]
}

// =====================================================
// SUBSCRIPTION
// =====================================================

model Subscription {
  id                 String             @id @default(cuid())
  companyId          String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  payments SubscriptionPayment[]

  @@index([companyId])
  @@index([planId])
  @@index([status])
}

// =====================================================
// SUBSCRIPTION PAYMENT
// Fake/Test payment for registration and subscriptions
// =====================================================

model SubscriptionPayment {
  id             String @id @default(cuid())
  companyId      String
  subscriptionId String
  planId         String

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  status        String @default("PAID")
  paymentMethod String @default("TEST_CARD")

  transactionId String @unique

  cardLast4 String?
  cardBrand String?

  isTest Boolean @default(true)

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([status])
}

// =====================================================
// CLIENT
// =====================================================

model Client {
  id        String @id @default(cuid())
  companyId String

  // =====================================================
  // BASIC INFORMATION
  // =====================================================

  name        String
  contactName String?
  email       String?
  phone       String?
  website     String?
  industry    String?
  tier        String?
  color       String?
  initials    String?

  // =====================================================
  // ADDRESS
  // =====================================================

  billingAddress String?
  city           String?
  stateRegion    String?
  postalCode     String?
  country        String?

  // =====================================================
  // TAX
  // =====================================================

  taxId String?

  // =====================================================
  // BILLING
  // =====================================================

  currency      String         @default("USD")
  mrr           Decimal        @default(0) @db.Decimal(15, 2)
  billingCycle  BillingCycle   @default(MONTHLY)
  paymentTerms  PaymentTerms   @default(NET_30)
  paymentMethod PaymentMethod?

  // =====================================================
  // CLIENT STATUS
  // =====================================================

  status ClientStatus @default(ACTIVE)

  // =====================================================
  // AUTOMATION / PREFERENCES
  // =====================================================

  autoCharge   Boolean @default(false)
  reminders    Boolean @default(true)
  portalAccess Boolean @default(true)
  welcomeEmail Boolean @default(true)

  // =====================================================
  // EXTRA INFORMATION
  // =====================================================

  notes String?

  tags Json?

  // =====================================================
  // BILLING / INVOICE INFORMATION
  // =====================================================

  nextInvoiceDate    DateTime?
  outstandingBalance Decimal   @default(0) @db.Decimal(15, 2)

  // =====================================================
  // AUDIT
  // =====================================================

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  // =====================================================
  // RELATIONS
  // =====================================================

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  projects Project[]

  // =====================================================
  // INDEXES
  // =====================================================

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, email])
  @@index([companyId, name])
  @@index([companyId, currency])
  @@index([companyId, billingCycle])
  @@index([companyId, createdAt])
}

// =====================================================
// CLIENT ENUMS
// =====================================================

enum ClientStatus {
  ACTIVE
  PENDING
  INACTIVE
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET_15
  NET_30
  NET_60
}

enum PaymentMethod {
  ACH
  CARD
  WIRE
  CHECK
}

// =====================================================
// INVOICE
// =====================================================

model Invoice {
  id            String @id @default(cuid())
  companyId     String
  clientId      String
  invoiceNumber String

  status   String  @default("draft")
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  issueDate DateTime  @default(now())
  dueDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items    InvoiceItem[]
  payments Payment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([clientId])
  @@index([status])
}

// =====================================================
// INVOICE ITEM
// =====================================================

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String

  quantity  Decimal @default(1) @db.Decimal(12, 2)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  amount    Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// =====================================================
// INVOICE PAYMENT
// Existing customer invoice payment system
// =====================================================

model Payment {
  id        String @id @default(cuid())
  invoiceId String

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("USD")

  status        String  @default("pending")
  paymentMethod String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
}

// =====================================================
// PROJECT
// =====================================================

model Project {
  id          String  @id @default(cuid())
  companyId   String
  clientId    String
  title       String
  clientName  String?
  projectType String?

  startDate DateTime
  endDate   DateTime

  description String?

  budget Float
  billed Float @default(0)

  billingMethod String?
  autoInvoice   Boolean @default(false)

  color    String?
  progress Int     @default(0)
  status   String
  icon     String?

  teamMembers Json?
  members     Int   @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  milestones Milestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([status])
}

// =====================================================
// MILESTONE
// =====================================================

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  title     String
  dueDate   DateTime

  amount Decimal @db.Decimal(15, 2)

  status String @default("scheduled")

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

// =====================================================
// EMAIL VERIFICATION
// =====================================================

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  verified  Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// =====================================================
// NOTIFICATION
// =====================================================

model Notification {
  id        String @id @default(cuid())
  companyId String
  title     String
  message   String

  type        String  @default("GENERAL")
  isRead      Boolean @default(false)
  isImportant Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
// =====================================================
// CUSTOM ROLE
// =====================================================

// =====================================================
// ROLE  (was CustomRole)
// =====================================================

model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])

  @@map("Role")   
}
// =====================================================
// TEAM MEMBER
// =====================================================

model TeamMember {
  id        String @id @default(cuid())
  companyId String

  name   String
  email  String
  avatar String?

  role   String            @default("VIEWER")
  status TeamMemberStatus @default(PENDING)

  channels String[] // ["email", "whatsapp", "github", "discord"]
  whatsapp String?
  github   String?
  discord  String?

  invitationToken   String?  @unique
  invitationMessage String?
  invitedById       String?
  invitedAt         DateTime @default(now())
  acceptedAt        DateTime?
  lastActivityAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, role])
  @@index([invitationToken])
}

enum TeamRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  INACTIVE
}
// =====================================================
// CURRENCY
// =====================================================

model Currency {
  code          String  @id
  name          String
  symbol        String
  locale        String? @default("en-US")
  decimalDigits Int     @default(2)
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  @@index([active])
  @@index([sortOrder])
}

// =====================================================
// USER ROLE
// =====================================================

enum UserRole {
  SUPER_ADMIN
  OWNER
  CFO
  CONTROLLER
  FINANCE_MANAGER
  OTHER
}

// =====================================================
// SUBSCRIPTION STATUS
// =====================================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}
